# ================= HH.RU =================
# After the application is approved, the simplest path is to copy the current
# application access token from https://dev.hh.ru/admin:
HH_ACCESS_TOKEN=

# Alternative: generate an application token once and cache it locally.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Search tuning
HH_AREA=113
HH_MIN_SCORE=45
HH_POLL_INTERVAL=1800
HH_INITIAL_LOOKBACK_HOURS=24
HH_REQUEST_DELAY=0.25
HH_SEARCH_FIELDS=name,description

# Optional hard filters. Leave false by default: remote/project work already gets
# a score bonus and hard filtering can hide useful permanent remote vacancies.
HH_REMOTE_ONLY=false
HH_PROJECT_ONLY=false

# Optional explicit API dictionary ids, comma-separated:
# HH_WORK_FORMAT=REMOTE
# HH_EMPLOYMENT_FORM=PROJECT
# HH_EXPERIENCE=noExperience,between1And3
# HH_PROFESSIONAL_ROLES=

# Override the default broad AI query if needed:
# HH_SEARCH_TEXT="AI video" OR Higgsfield OR LLM OR "Telegram bot"

# ================= TELEGRAM BOT OUTPUT =================
# Create a normal Telegram bot via @BotFather. No personal Telegram session is
# required for HH notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================= OPTIONAL TELEGRAM SOURCE LISTENER =================
# Only needed if you also run vacancy_bot.py to READ selected channels via
# Telethon. Not used by hh_bot.py.
# API_ID=
# API_HASH=
# PHONE=+79990000000
# TARGET_CHANNEL=
# SOURCE_CHANNELS=channel_one,channel_two
